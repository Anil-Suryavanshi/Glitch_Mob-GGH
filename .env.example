# FaultForge AI Environment Configuration

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Recommended: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Connection URL
DATABASE_URL=sqlite:///./faultforge.db

# Server Host and Port
HOST=127.0.0.1
PORT=8000
